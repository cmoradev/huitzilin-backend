# Dependencies

# 1. Pull the official Node.js image
FROM node:24.21.0-trixie-slim AS deps
# 2. Set the working directory
WORKDIR /usr/src/app
# 3. Copy package.json and package-lock.json to the working directory
COPY package*.json ./
# 4. Install the dependencies
RUN npm install

# Build

# 1. Pull the official Node.js image
FROM node:24.21.0-trixie-slim AS builder
# 2. Set the working directory
WORKDIR /usr/src/app
# 3. Copy npm dependencies from the deps stage
COPY --from=deps /usr/src/app/node_modules ./node_modules
# 4. Copy the rest of the application to the working directory
COPY . .
# 5. Build the application
RUN npm run build
# 6. Remove the development dependencies
RUN npm ci -f --only=production
# 7. Remove the cache
RUN npm cache clean --force

# Production image

# 1. Pull the official Node.js image
FROM node:24.21.0-trixie-slim AS prod
# 2. Set the working directory
WORKDIR /usr/src/app
# 3. Copy npm dependencies from the build stage
COPY --from=builder /usr/src/app/node_modules ./node_modules
# 4. Copy the dist folder from the build stage
COPY --from=builder /usr/src/app/dist ./dist
# 5. Set the environment variable NODE_ENV to production
ENV NODE_ENV=production
# 6. Set the user to node
USER node
# 7. Expose the port of the application
EXPOSE 3000
# 8. Start the application
CMD ["node", "dist/main.js"]